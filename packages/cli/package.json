      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@attentive-kit/protocol": "workspace:*"
  }
