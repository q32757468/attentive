{
  "name": "attentive-vscode",
  "displayName": "Attentive",
  "description": "Routes Attentive notification clicks back to the source VS Code window.",
  "version": "0.1.4",
  "publisher": "attentive",
  "license": "MIT",
  "icon": "assets/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/q32757468/attentive.git"
  },
  "type": "commonjs",
  "main": "./dist/extension.js",
  "engines": {
    "vscode": "^1.100.0"
  },
  "extensionKind": ["workspace"],
  "activationEvents": ["*"],
  "categories": ["Other"],
  "files": [
    "dist",
    "assets/icon.png",
    "README.md",
    "CHANGELOG.md",
    "SUPPORT.md",
    "LICENSE"
  ],
  "contributes": {
    "commands": [
      {
        "command": "attentive.showCallbackStatus",
        "title": "Attentive: Show VS Code Integration Status"
      }
    ]
  },
  "scripts": {
    "build": "tsup",
    "package:vsix": "pnpm run build && mkdir -p artifacts && vsce package --no-dependencies --allow-star-activation --out artifacts/attentive-vscode-${npm_package_version}.vsix",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@attentive/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/vscode": "1.100.0",
    "@vscode/vsce": "^3.6.0"
  }
}
